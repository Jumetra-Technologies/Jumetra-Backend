{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "name", "category", "manufacturer", "interfaces", "voltage", "behavior", "renderer", "pins", "keywords"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "manufacturer": {"type": "string", "minLength": 1},
    "interfaces": {"type": "array", "items": {"type": "string"}},
    "voltage": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
    "behavior": {"type": "string", "minLength": 1},
    "renderer": {"type": "string", "minLength": 1},
    "pins": {"type": "string", "minLength": 1},
    "keywords": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
